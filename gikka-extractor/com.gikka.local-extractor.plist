<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.gikka.local-extractor</string>
    <!-- 저장소 체크아웃(Jenkins 의 Sync Local 이 git pull 하는 그 경로)의 server.py 를 직접 돌린다.
         이전엔 ~/gikka-local/server.py 라는 손으로 뜬 사본을 돌렸는데, 저장소만 갱신되고 사본은
         그대로 남아 두 달치 코드가 조용히 안 반영됐다 (2026-07-16 발견 — transcriptChars 를
         안 보내 품질 경고 기능이 125/125 한 번도 작동 못 함). 사본을 없애 그 사고를 원천 차단.
         모델·로그는 여전히 ~/gikka-local 아래(WorkingDirectory) — 저장소에 둘 것이 아니므로. -->
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>/Users/honey/devcontext/project/lab/gikka-extractor/server.py</string>
    </array>
    <!-- launchd 는 기본 PATH 가 /usr/bin:/bin:/usr/sbin:/sbin 이라 homebrew 경로가 없다.
         server.py 는 yt-dlp·ffmpeg·whisper 를 절대경로로 부르니 그건 괜찮았는데, deno 는
         yt-dlp 가 PATH 에서 스스로 찾는 방식이라 안 보였다 — deno 가 설치돼 있는데도 yt-dlp 가
         "No supported JavaScript runtime" 경고를 내며 deprecated 경로로 유튜브를 긁고 있었다
         (2026-07-16 실측: 최소 PATH 로 실행하면 경고, /opt/homebrew/bin 을 넣으면 사라짐).
         유튜브가 JS 챌린지를 강제하면 로컬 추출이 통째로 멈추고 전부 Gemini 로 쏠리므로 대비. -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/Users/honey/gikka-local/server.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/honey/gikka-local/server.log</string>
    <key>WorkingDirectory</key>
    <string>/Users/honey/gikka-local</string>
</dict>
</plist>
